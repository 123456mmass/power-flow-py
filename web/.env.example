# Browser API path. Keep this same-origin so auth, mutations and SSE all use
# the Next.js proxy when SOLVER_API_BASE is configured.
NEXT_PUBLIC_SOLVER_API_BASE=/api

# Optional Python REST/SSE service used by server-rendered pages and proxied
# /api solver routes. Leave unset to use the deterministic bundled UI mock.
# SOLVER_API_BASE=http://127.0.0.1:8000/api

# Show the demo credentials panel on the login page. NEVER enable in production.
NEXT_PUBLIC_ENABLE_DEMO_CREDENTIALS=true

# HMAC secret for the signed session cookie. Set a strong random value in any
# shared or production environment.
AUTH_SESSION_SECRET=development-only-session-secret-change-me
